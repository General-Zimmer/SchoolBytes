<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width" />
    <meta charset="UTF-8">
    <title>Index</title>
    <style>

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
        }

        select {
            width: 100%;
            padding: 8px;
            font-size: 14px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }

        button {
            padding: 10px 20px;
            font-size: 16px;
            background-color: #007bff;
            color: #fff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

            button:hover {
                background-color: #0056b3;
            }
    </style>
</head>
<body>

    <h2>Download af rapporter</h2>
    <form method="post" action="report/download">
        <div class="container">
            <div class="form-group">
                <label for="participantSelect">Vælg Deltager</label>
                <select id="participantSelect" name="SelectedParticipant">
                    <option value="0">Alle</option>
                    @foreach (var p in ViewBag.Participants)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="courseSelect">Vælg Hold</label>
                <select id="courseSelect" name="SelectedCourse">
                    <option value="0">Alle</option>
                    @foreach (var c in ViewBag.Courses)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="container">
            <button type="submit">Download rapport</button>
        </div>
    </form>

</body>
</html>